# Copy this file to .env and fill in your values
# NEVER commit .env to git
#
# Tout ce qui commence par VITE_ est recopié en clair dans le JavaScript envoyé
# au navigateur : ces valeurs sont publiques par construction. N'y mettre que ce
# qui peut l'être. Une clé facturée à l'usage n'a rien à faire ici — voir
# supabase/functions/ai/ pour la clé Mistral, qui reste côté serveur.

VITE_TMDB_API_KEY=your_tmdb_api_key_here
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_POSTHOG_KEY=phc_your_posthog_key_here
VITE_POSTHOG_HOST=https://eu.i.posthog.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
